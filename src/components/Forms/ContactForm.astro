---
// componentes
import Button from "@components/Button/Button.astro";
---

<form id="contact-form" name="formulario de contacto" class="flex h-full flex-col justify-between gap-6">
	<input type="hidden" name="form-name" value="contact" />
	
	<div class="group relative">
		<label for="contact-name" class="font-heading-1 mb-1 block text-lg uppercase transition-all">Tu Nombre</label>
		<input 
			type="text" 
			class="form__input w-full rounded-md border border-primary-200 bg-white py-3 px-4 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" 
			name="name" 
			id="contact-name" 
			placeholder="María García" 
			required 
		/>
	</div>
	
	<div class="group relative">
		<label for="contact-email" class="font-heading-1 mb-1 block text-lg uppercase transition-all">Email de Contacto</label>
		<input
			type="email"
			class="form__input w-full rounded-md border border-primary-200 bg-white py-3 px-4 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
			name="email"
			id="contact-email"
			inputmode="email"
			placeholder="tu@email.com"
			required
		/>
	</div>
	
	<div class="group relative">
		<label for="contact-date" class="font-heading-1 mb-1 block text-lg uppercase transition-all">Fecha del Evento</label>
		<input 
			type="date" 
			class="form__input w-full rounded-md border border-primary-200 bg-white py-3 px-4 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" 
			name="date" 
			id="contact-date" 
			required 
		/>
		<small class="mt-1 block text-sm text-gray-600">Formato: día/mes/año</small>
	</div>
	
	<div class="group relative">
		<label for="contact-type" class="font-heading-1 mb-1 block text-lg uppercase transition-all">Tipo de Evento</label>
		<select 
			class="form__input w-full rounded-md border border-primary-200 bg-white py-3 px-4 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500" 
			name="event-type" 
			id="contact-type" 
			required
		>
			<option value="" disabled selected>Selecciona tipo de evento</option>
			<option value="boda">Boda</option>
			<option value="compromiso">Compromiso</option>
			<option value="fuga">Fuga de Novios</option>
			<option value="otro">Otro</option>
		</select>
	</div>
	
	<div class="group relative">
		<label for="contact-message" class="font-heading-1 mb-1 block text-lg uppercase transition-all">Mensaje</label>
		<textarea
			name="message"
			class="form__input w-full rounded-md border border-primary-200 bg-white py-3 px-4 shadow-sm focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500"
			id="contact-message"
			rows="5"
			placeholder="Cuéntame sobre tu evento y lo que estás buscando..."
			required></textarea>
	</div>
	
	<div class="mt-4 flex">
		<Button 
			variant="primary" 
			type="submit" 
			class="group relative w-full overflow-hidden rounded-md px-10 py-3 transition-all duration-300 hover:shadow-lg md:w-fit"
		>
			Enviar
		</Button>
	</div>
</form>

<script>
	// Script para mejorar la experiencia del formulario
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('contact-form') as HTMLFormElement;
		
		if (form) {
			form.addEventListener('submit', (e: Event) => {
				e.preventDefault();
				
				// Aquí iría la lógica de envío del formulario
				// Por ahora solo mostramos un mensaje
				alert('¡Gracias por tu mensaje! Te contactaremos pronto.');
				form.reset();
			});
		}
	});
</script>