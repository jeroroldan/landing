---
import CountUpCard from "../React/CountUpCard/CountUpCard";

/**
 * * These are cards with a large number, and description below
 */

interface Props {
	largeText: string;
	description: string;
	duration?: number; // Añadido para controlar la duración de la animación
	rest?: any; // catch-all for any additional parameters, such as "aria-label"
}

const { largeText, duration = 2, description, ...rest } = Astro.props as Props;
---

<div {...rest} class="flex flex-col gap-3 text-center">
	<CountUpCard
		largeText={largeText}
		description={description}
		duration={duration}
		client:only="react"
	/>
</div>
